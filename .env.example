# Hosted deployments must use supabase. Local mode is refused on Vercel.
MARKET_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional explicit origin. Vercel uses its own production or preview domain by default.
APP_ORIGIN=
CHAIN_RPC_URL=
CHAIN_ID=11155111
MARKET_ADDRESS=
PAYMENT_TOKEN_ADDRESS=
# Evaluation attestation only; never a seller or buyer signing key.
VALIDATOR_PRIVATE_KEY=
# Optional intent extraction and real model comparison trials. Use a fixed model snapshot.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional verified rates per million tokens in USD. Missing rates mean cost unknown.
MODEL_INPUT_USD_PER_MILLION=
MODEL_CACHED_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
MODEL_PRICING_SOURCE=
